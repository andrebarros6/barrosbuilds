# Copy this file to .env.local and fill in the real values.
#   cp .env.local.example .env.local
#
# Supabase → Settings → API
#
# SUPABASE_SERVICE_ROLE_KEY is the `service_role` secret, NOT `anon public`.
# It bypasses Row Level Security — full database access. Never prefix it
# NEXT_PUBLIC_, never import it into a client component, never commit it.
# It is only read server-side in app/api/waitlist/route.ts.
#
# .env.local is gitignored (.env* in .gitignore). This example file is safe
# to commit because it contains no real values.
#
# Same two vars also go in Vercel → Settings → Environment Variables
# (Production + Preview), or the deployed route returns 503.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend → API Keys. Sending permission only, not full access.
# Needs barrosbuilds.com verified as a domain first — see docs/welcome-email.md
RESEND_API_KEY=re_your_key_here
